{
    "_description": "Binder transaction analysis rules",
    "_table": "binder",
    "_data_path": "analysis_input.apps.{app}.{launch_type}.binder_transaction",
    "metrics": {
        "duration_ms": {
            "description": "Total binder transaction duration",
            "fields": [
                "dut",
                "ref",
                "diff"
            ],
            "threshold_diff_ms": 5,
            "higher_is_worse": true
        },
        "count": {
            "description": "Number of binder transactions",
            "fields": [
                "dut",
                "ref",
                "diff"
            ],
            "threshold_diff": 10,
            "higher_is_worse": true
        }
    },
    "analysis_logic": {
        "rule_1": "Nếu count cao hơn = nhiều IPC calls hơn",
        "rule_2": "Nếu duration cao hơn với count tương tự = mỗi call chậm hơn"
    },
    "solutions": []
}