{
    "_description": "Top CPU analysis rules",
    "_table": "top_cpu",
    "_data_path": "analysis_input.apps.{app}.{launch_type}.top_cpu",
    "process": {
        "description": "Top CPU consuming processes",
        "fields": [
            "name",
            "dut",
            "ref",
            "diff"
        ],
        "threshold_diff_ms": 5,
        "known_processes": {
            "system_server": {
                "owner": "framework",
                "high_cpu_causes": [
                    "Binder transaction",
                    "Activity lifecycle",
                    "Package management"
                ]
            },
            "surfaceflinger": {
                "owner": "graphics",
                "high_cpu_causes": [
                    "Frame composition",
                    "VSync handling"
                ]
            },
            "launching_app": {
                "owner": "app",
                "high_cpu_causes": [
                    "App initialization",
                    "Dex loading",
                    "Resource loading"
                ]
            }
        }
    },
    "thread": {
        "description": "Top CPU consuming threads",
        "fields": [
            "name",
            "dut",
            "ref",
            "diff"
        ],
        "threshold_diff_ms": 3
    },
    "solutions": []
}